---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Writing" description="Essays on building AI products: evaluation, interface choice, and measurement.">
  <h1>Writing</h1>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.data.permalink ?? post.id}/`}>{post.data.title}</a>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
