---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies', ({ data }) => data.status === 'live');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}
const { study } = Astro.props;
const { Content } = await render(study);
const { title, problem, role, decisions, headlineNumber } = study.data;
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Base title={title} description={problem}>
  <article>
    <div class="case-card__head">
      <h1>{title}</h1>
      <span class="chip">{headlineNumber}</span>
    </div>
    <p class="problem">{problem} <em>Role: {role}.</em></p>
    <div class="ledger">
      {decisions.map((d) => (
        <div class="ledger-row">
          <span class="ledger-row__label">Decided</span>
          <p>{capitalize(d.decision)}, because {d.because}. <span class="measured-by">measured by {d.measuredBy}</span></p>
        </div>
      ))}
      <div class="ledger-bottom"></div>
    </div>
    <details>
      <summary>The full story: reasoning, trade-offs, what went wrong</summary>
      <Content />
    </details>
  </article>
</Base>
