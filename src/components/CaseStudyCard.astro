---
import type { CollectionEntry } from 'astro:content';
interface Props {
  study: CollectionEntry<'caseStudies'>;
}
const { study } = Astro.props;
const { title, problem, role, decisions, headlineNumber, status } = study.data;
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<article class="case-card">
  <div class="case-card__head">
    <h3>
      {status === 'live' ? <a href={`/case-studies/${study.id}/`}>{title}</a> : title}
    </h3>
    {status === 'live' && <span class="chip">{headlineNumber}</span>}
    {status === 'reserved' && <span class="reserved">reserved: Q4</span>}
  </div>
  <p class="problem">{problem} <em>Role: {role}.</em></p>
  <div class="ledger">
    {decisions.map((d) => (
      <div class="ledger-row">
        <span class="ledger-row__label">Decided</span>
        <p>{capitalize(d.decision)}, because {d.because}. <span class="measured-by">measured by {d.measuredBy}</span></p>
      </div>
    ))}
    <div class="ledger-bottom"></div>
  </div>
</article>
